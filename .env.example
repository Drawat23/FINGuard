# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional PostgreSQL connection string.
# If unset, FINGuard runs with a zero-config persistent relational JSON store.
DATABASE_URL=

# UPSTOX_API_KEY & UPSTOX_API_SECRET: Optional Upstox API v2/v3 Developer App credentials.
# Configure in AI Studio Secrets to enable live Upstox OAuth, market quotes, historical candles & WebSocket ticks.
UPSTOX_API_KEY=
UPSTOX_API_SECRET=

# FINNHUB_API_KEY & NEWS_API_KEY: Optional real-time institutional news API keys.
# Even when unset, FINGuard streams live Forex Factory macro calendar + NSE/Global market news RSS feeds.
FINNHUB_API_KEY=
NEWS_API_KEY=
